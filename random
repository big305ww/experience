-- Jump Multiplier + Infinite Stamina GUI
-- Default keybind: K

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer

local currentKeybind = Enum.KeyCode.K
local listeningForKey = false

-- Jump Multiplier
local function getJumpMultiplier()
	local character = player.Character or player.CharacterAdded:Wait()
	local playerInfo = character:WaitForChild("PlayerInfo", 10)
	if not playerInfo then return nil end
	return playerInfo:FindFirstChild("JumpMultiplier")
end

local jumpMult = getJumpMultiplier()

-- Stamina
local staminaEnabled = true
local staminaConnection = nil
local stamina = nil

local function getStamina()
	local character = player.Character or player.CharacterAdded:Wait()
	local playerInfo = character:WaitForChild("PlayerInfo", 10)
	if not playerInfo then return nil end
	return playerInfo:FindFirstChild("Stamina")
end

local function startStamina()
	if staminaConnection then
		staminaConnection:Disconnect()
	end

	staminaConnection = RunService.Heartbeat:Connect(function()
		if not staminaEnabled then return end

		if not stamina or not stamina.Parent then
			stamina = getStamina()
			if not stamina then return end
		end

		if stamina.Value < stamina.MaxValue then
			stamina.Value = stamina.MaxValue
		end
	end)
end

