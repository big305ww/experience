-- Functions
local function updateJumpLabel()
	if jumpMult then
		ValueLabel.Text = "Current: " .. string.format("%.1f", jumpMult.Value) .. "  →  Height: " .. string.format("%.1f", 7.2 + jumpMult.Value)
	end
end

ApplyButton.MouseButton1Click:Connect(function()
	local num = tonumber(TextBox.Text)
	if num and jumpMult then
		jumpMult.Value = math.clamp(num, -100, 100)
		updateJumpLabel()
	end
end)

ResetButton.MouseButton1Click:Connect(function()
	if jumpMult then
		jumpMult.Value = 2
		TextBox.Text = "2"
		updateJumpLabel()
	end
end)

StaminaToggle.MouseButton1Click:Connect(function()
	staminaEnabled = not staminaEnabled
	if staminaEnabled then
		StaminaToggle.BackgroundColor3 = Color3.fromRGB(0, 200, 80)
		StaminaToggle.Text = "ON"
	else
		StaminaToggle.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
		StaminaToggle.Text = "OFF"
	end
end)

KeybindButton.MouseButton1Click:Connect(function()
	listeningForKey = true
	KeybindButton.Text = "Press any key..."
	KeybindButton.BackgroundColor3 = Color3.fromRGB(200, 150, 0)
end)

CloseButton.MouseButton1Click:Connect(function()
	Frame.Visible = false
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end

	if listeningForKey and input.UserInputType == Enum.UserInputType.Keyboard then
		currentKeybind = input.KeyCode
		KeybindButton.Text = "Key: " .. input.KeyCode.Name
		KeybindButton.BackgroundColor3 = Color3.fromRGB(80, 80, 100)
		listeningForKey = false
		return
	end

	if input.KeyCode == currentKeybind then
		Frame.Visible = not Frame.Visible
	end
end)

-- Start
if jumpMult then
	updateJumpLabel()
	jumpMult:GetPropertyChangedSignal("Value"):Connect(updateJumpLabel)
end

stamina = getStamina()
startStamina()

player.CharacterAdded:Connect(function()
	task.wait(1)
	jumpMult = getJumpMultiplier()
	stamina = getStamina()
	if jumpMult then
		updateJumpLabel()
	end
end)
